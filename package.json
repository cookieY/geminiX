{
  "name": "yearning-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:frames": "MOTION_FRAMES_ONLY=1 playwright test tests/e2e/motion-frames.spec.ts --workers=1",
    "screenshots": "playwright test tests/e2e/screenshots.spec.ts tests/e2e/screenshots-business.spec.ts",
    "screenshots:update": "playwright test tests/e2e/screenshots.spec.ts tests/e2e/screenshots-business.spec.ts --update-snapshots",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:tokens": "node scripts/check-token-contrast.mjs",
    "check:colors": "node scripts/scan-raw-colors.mjs",
    "check:prohibited": "node scripts/scan-prohibited.mjs",
    "check:motion": "node scripts/scan-motion.mjs && node scripts/scan-motion.mjs --self-test",
    "check:assets": "node scripts/check-assets.mjs",
    "check:registry": "node scripts/generate-registry-inventory.mjs --check",
    "api:generate": "orval --config orval.config.ts && node scripts/generate-projections.mjs && node scripts/generate-contract-manifest.mjs",
    "api:manifest": "node scripts/generate-contract-manifest.mjs",
    "api:breaking": "node scripts/api-breaking.mjs --self-test && node scripts/api-breaking.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:storage": "node scripts/scan-browser-storage.mjs",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "contract:diff": "node scripts/contract-diff.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "3.14.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fflate": "^0.8.3",
    "i18next": "26.5.3",
    "lucide-react": "1.60.0",
    "monaco-editor": "^0.57.0",
    "motion": "^14.4.0",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-resizable-panels": "^4.14.8",
    "react-router": "8.5.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@oasdiff-js/oasdiff-js": "1.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "orval": "8.43.0",
    "shadcn": "^4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
